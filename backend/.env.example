# Required: any OpenAI-compatible API (hosted provider or local server).
# These values are the setup the app was tested with (README, "Models tested"): Qwen3.6-35B-A3B, a free open
# model, on a local llama.cpp server. Change them for your own server or provider.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=any
LLM_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_M

# Examples
# Local Ollama:      LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_API_KEY=any   LLM_MODEL=<model you pulled>
# OpenRouter-style:  LLM_BASE_URL=https://<router>/v1        LLM_MODEL=<vendor>/<model>
# OpenAI (paid):     LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=<your key>  LLM_MODEL=<model>

# Optional
LLM_TIMEOUT_SECONDS=60
# JSON added to every request. Turn reasoning off for thinking models; leave it empty for OpenAI, Anthropic and
# other non-thinking models:
#   llama.cpp + Qwen3:  {"chat_template_kwargs": {"enable_thinking": false}}
#   OpenRouter-style:   {"reasoning": {"enabled": false}}
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Optional: a different model per role. Each value falls back to the LLM_* setting when empty.
# Roles: CLASSIFIER (which needs a question uncovers), CLIENT (the persona), GUARD (checks each reply), COACH (feedback).
# EXTRA_BODY is provider-specific, so a role on a different BASE_URL does not inherit LLM_EXTRA_BODY; "{}" clears it.
# Example, a stronger coach with reasoning on:  COACH_MODEL=<model>  COACH_EXTRA_BODY={"reasoning": {"enabled": true}}
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=
CLASSIFIER_EXTRA_BODY=
CLIENT_BASE_URL=
CLIENT_API_KEY=
CLIENT_MODEL=
CLIENT_EXTRA_BODY=
GUARD_BASE_URL=
GUARD_API_KEY=
GUARD_MODEL=
GUARD_EXTRA_BODY=
COACH_BASE_URL=
COACH_API_KEY=
COACH_MODEL=
COACH_EXTRA_BODY=

# Optional: a local JSONL file (never uploaded) with one line per graph node and per model call, in order.
# logs/ is git-ignored, e.g. LLM_CALL_LOG=logs/calls.jsonl
LLM_CALL_LOG=
# 1 = also write each call's full prompt and raw output to that file. They contain the clients' hidden facts
# and the student's words: use it for debugging on your own machine only.
LLM_CALL_LOG_CONTENT=

# Evaluation only: a judge from a different model family than LLM_MODEL (empty = skip judged metrics)
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
