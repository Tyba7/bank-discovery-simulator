# Required: any OpenAI-compatible API (hosted provider or local server)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Examples
# Local llama.cpp:   LLM_BASE_URL=http://127.0.0.1:8080/v1   LLM_API_KEY=any   LLM_MODEL=<model name the server reports>
# Local Ollama:      LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_API_KEY=any   LLM_MODEL=<model you pulled>
# OpenRouter-style:  LLM_BASE_URL=https://<router>/v1        LLM_MODEL=<vendor>/<model>

# Optional
LLM_TIMEOUT_SECONDS=60
# JSON added to every request. Turn reasoning off for thinking models:
#   llama.cpp + Qwen3:  {"chat_template_kwargs": {"enable_thinking": false}}
#   OpenRouter-style:   {"reasoning": {"enabled": false}}
LLM_EXTRA_BODY=

# Optional: append one JSON line per model call to this local file (never uploaded)
LLM_CALL_LOG=

# Evaluation only: a judge from a different model family than LLM_MODEL (empty = skip judged metrics)
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
